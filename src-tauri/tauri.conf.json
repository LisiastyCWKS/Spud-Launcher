{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spud Launcher",
  "version": "0.1.0",
  "identifier": "dev.spud.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spud Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "Spud Overlay",
        "url": "overlay.html",
        "width": 380,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Fast, minimal Minecraft launcher",
    "longDescription": "Spud Launcher isolates every Minecraft instance, installs Fabric, Quilt, Forge and NeoForge, and browses Modrinth without leaving the app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
